rules_version = '2';

// 排行榜：任何人都能讀；每個暱稱一份文件（ID = 小寫暱稱）。
// 第一次寫入是新增；之後只有「到達樓層更高，或同樓層分數更高」才能覆蓋，不能刪除。
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(d) {
      return d.keys().hasOnly(['nickname', 'floor', 'score', 'at'])
        && d.keys().hasAll(['nickname', 'floor', 'score', 'at'])
        && d.nickname is string
        && d.nickname.size() >= 1
        && d.nickname.size() <= 12
        && d.floor is int
        && d.floor >= 1
        && d.floor <= 4
        && d.score is int
        && d.score >= 0
        && d.score <= 9999999
        && d.at is int;
    }

    function beats(next, prev) {
      return next.floor > prev.floor || (next.floor == prev.floor && next.score > prev.score);
    }

    match /scores/{scoreId} {
      allow list: if request.query.limit <= 50;
      allow get: if true;
      allow create: if validScore(request.resource.data);
      allow update: if validScore(request.resource.data) && beats(request.resource.data, resource.data);
      allow delete: if false;
    }
  }
}
